# ==============================================================================
# Orchestrix AI — Backend Environment Configuration
# ==============================================================================

APP_NAME="Orchestrix AI"
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database & Cache (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300
DB_ECHO=false

# GitHub App Integration
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PRIVATE_KEY_PATH=keys/orchestrix-ai.private-key.pem
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_NAME=Orchestrix-AI
GITHUB_APP_SLUG=orchestrix-ai
GITHUB_APP_URL=https://github.com/apps/orchestrix-ai
GITHUB_REPOSITORY_URL=https://github.com/nandakumar-123/Orchestrix-AI.git

# AI Providers
GEMINI_API_KEY=
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest
MISTRAL_API_BASE_URL=https://api.mistral.ai/v1

# Cloud & Infrastructure
GOOGLE_CLOUD_PROJECT_NAME=
GOOGLE_CLOUD_PROJECT_RESOURCE=
GOOGLE_CLOUD_PROJECT_NUMBER=

# Knowledge Graph & Cache
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
REDIS_URL=redis://localhost:6379/0
REDIS_TOKEN=

# Authentication (Google OAuth 2.0 & Session Security)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_FRONTEND_URL=http://localhost:3000
SESSION_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
SESSION_TTL_SECONDS=604800
FRONTEND_ORIGIN=http://localhost:3000
CSRF_COOKIE_NAME=orchestrix_csrf
OAUTH_TRX_COOKIE_NAME=orchestrix_oauth_trx
